APP_NAME="Cynaris CIA Career Intelligence"
APP_ENV=local
APP_KEY=base64:CYNARIS_WEEK7_DAY1_SECURE_KEY_2026=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cia_career_intelligence
DB_USERNAME=root
DB_PASSWORD=

# Primary LLM Provider: Groq Cloud (Ultra-Fast Inference)
GROQ_API_KEY=
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=10

# Fallback LLM Provider: OpenRouter (Multi-Model Resilience)
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_TIMEOUT=12

# Vector Store: ChromaDB (Skill & Resume Embeddings)
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION=candidate_career_vectors
